# .env.example

# ── Jira / Atlassian ─────────────────────────────────────────────────
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-jira-api-token

# ── Gemini AI ──────────────────────────────────────────────────────
AI_ENABLED=true
GEMINI_API_KEY=your-gemini-api-key

# ── PostgreSQL ───────────────────────────────────────────────────────
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_NAME=auto_reports

# ── 스케줄러 ────────────────────────────────────────────────────────────────
SCHEDULE_CRON=0 23 * * 5
TZ=Asia/Seoul

# ── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://your-domain.com"]

# ── 앱 포트 ────────────────────────────────────────────────────────────────
APP_PORT=80

# ── SSL / 도메인 ────────────────────────────────────────────────────────────
DOMAIN=your-domain.com
SSL_EMAIL=your@email.com

# ── Confluence (선택) ────────────────────────────────────────────────────────────
CONFLUENCE_SPACE_KEY=
CONFLUENCE_PARENT_PAGE_ID=

# ── Admin (선택) ─────────────────────────────────
LOGIN=true
ADMIN=ADMIN
ADMIN_PASSWORD=ADMIN_PASSWORD
SUPERADMIN=SUPERADMIN
SUPERADMIN_PASSWORD=SUPERADMIN_PASSWORD
JWT_SECRET=

# ── 보안 (ISS-007) ───────────────────────────────────────────────────────────
# 운영 환경(HTTPS)에서는 true 로 설정 — refresh_token 쿠키에 Secure 플래그 적용
# 로컬/개발 환경에서는 false 유지
COOKIE_SECURE=false

# ── 자격증명 암호화 (ISS-003) ────────────────────────────────────────────────
# access_credentials 패스워드 필드를 Fernet 대칭 암호화로 저장
# 키 생성: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 비워 두면 암호화 비활성화 (개발 환경 전용)
CREDENTIAL_ENCRYPTION_KEY=
