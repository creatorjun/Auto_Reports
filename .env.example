# .env.example

# ── Jira / Atlassian ─────────────────────────────────────────────────
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-jira-api-token
ISSUE_TYPES=["인시던트","개선","CVE","서비스 요청","H/W 장애 요청","승인된 서비스 요청"]

# ── Gemini AI ──────────────────────────────────────────────────────
AI_ENABLED=true
GEMINI_API_KEY=your-gemini-api-key

# ── PostgreSQL ───────────────────────────────────────────────────────
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_NAME=auto_reports

# ── 스케줄러 ────────────────────────────────────────────────────────────────
SCHEDULE_CRON=0 23 * * 5
TZ=Asia/Seoul

# ── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://your-domain.com"]

# ── 앱 포트 ────────────────────────────────────────────────────────────────
APP_PORT=80

# ── SSL / 도메인 ────────────────────────────────────────────────────────────
DOMAIN=your-domain.com
SSL_EMAIL=your@email.com

# ── Confluence (선택) ────────────────────────────────────────────────────────────
CONFLUENCE_SPACE_KEY=
CONFLUENCE_PARENT_PAGE_ID=

# ── Admin (선택) ─────────────────────────────────
LOGIN=true
ADMIN=ADMIN
ADMIN_PASSWORD=ADMIN_PASSWORD
SUPERADMIN=SUPERADMIN
SUPERADMIN_PASSWORD=SUPERADMIN_PASSWORD
JWT_SECRET=

# ── 보안 ─────────────────────────────────────────────────────────────────────
COOKIE_SECURE=false
CREDENTIAL_ENCRYPTION_KEY=

# ── Synology SMTP 메일 알림 ──────────────────────────────────────────────────
SMTP_HOST=192.168.x.x
SMTP_PORT=587
SMTP_USER=noreply@your-company.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@your-company.com
SMTP_USE_TLS=false
SMTP_START_TLS=true

# 할일 이슈 알림 활성화 여부 (true / false)
# 보고서 새로고침 시 할일 상태 이슈가 있으면 자동으로 메일 발송
NOTIFY_TODO_ENABLED=false

# 수신자 이메일 목록 (JSON 배열 형식)
NOTIFY_TODO_TO=["manager@your-company.com"]

# ── 보고서 자동 갱신 ──────────────────────────────────────────────────────
REFRESH_REPORT_ENABLED=true
REFRESH_REPORT_INTERVAL_MINUTES=5
